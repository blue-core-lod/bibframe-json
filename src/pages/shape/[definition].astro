---
/**
 * A page per definition in the shape: Work, Instance, Hub, Item, and the
 * eleven nested ones.
 *
 * Generated from two sources, neither of them prose anybody wrote here. The
 * schema file says which properties this definition names and what kind of
 * value each takes. bibframe_json/vocabulary.json says what BIBFRAME calls
 * each term and what LC's own definition of it is. Joining them is all these
 * pages do, and it means the reference cannot drift from the schema it
 * documents.
 *
 * Deliberately not attempted: explaining the model. That is LC's BIBFRAME
 * primer, linked per definition where there is a section for it.
 */
import { Code } from "astro:components";

import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";

import vocabulary from "../../../bibframe_json/vocabulary.json";
import { PRIMER } from "../../data/primer";
import { url } from "../../data/published";

type Schema = {
  title?: string;
  description?: string;
  properties?: Record<string, Property>;
  anyOf?: Schema[];
  examples?: unknown[];
  type?: string | string[];
  additionalProperties?: unknown;
};

type Property = {
  type?: string;
  description?: string;
  items?: { $ref?: string };
  $ref?: string;
};

const schemas = import.meta.glob<Schema>(
  "../../../bibframe_json/schema/dialect/*.json",
  { eager: true, import: "default" },
);

export function getStaticPaths() {
  const files = import.meta.glob<Schema>(
    "../../../bibframe_json/schema/dialect/*.json",
    { eager: true, import: "default" },
  );
  return Object.keys(files)
    .map((path) => path.split("/").pop()!.replace(".json", ""))
    // main.json is the dispatch rather than a definition, and there is
    // nothing to say about it that the shape page does not say better.
    .filter((name) => name !== "main")
    .map((name) => ({ params: { definition: name } }));
}

const { definition } = Astro.params;
const [path] = Object.keys(schemas).filter((key) =>
  key.endsWith(`/${definition}.json`),
);
const schema = schemas[path];

/** JSON-LD keywords are not properties and have nothing in the vocabulary. */
const KEYWORDS = ["@id", "@type", "@value", "@language", "@context"];

/** The local name, so `bflc:aap` and `rdfs:label` find their entry. */
const localName = (property: string) => property.split(":").pop()!;

/**
 * The vocabularies a property can come from other than BIBFRAME itself.
 *
 * 22 of the 122 properties named across the definitions are from one of
 * these, and none of them is a BIBFRAME term missing a definition. Saying
 * "not in the vocabulary" would be true and misleading; saying which
 * vocabulary defines it is useful. The BFLC ones would gain definitions here
 * if the BFLC ontology were added as a generator input, which is already
 * noted as worth doing in generate/from_ontology.py.
 */
const FOREIGN: Record<string, { name: string; href: string }> = {
  rdfs: {
    name: "RDF Schema",
    href: "https://www.w3.org/TR/rdf-schema/",
  },
  rdf: {
    name: "RDF",
    href: "https://www.w3.org/TR/rdf11-concepts/",
  },
  bflc: {
    name: "the BIBFRAME LC extension",
    href: "http://id.loc.gov/ontologies/bflc/",
  },
  mads: {
    name: "MADS/RDF",
    href: "http://www.loc.gov/mads/rdf/v1",
  },
};

const foreign = (property: string) =>
  property.includes(":") ? FOREIGN[property.split(":")[0]] : undefined;

/**
 * Whether a term's label says more than its property name already does.
 *
 * "Subject" after `subject` is noise; "Instance of Work" after `hasInstance`
 * is the sort of thing a reader wants. Compared with the punctuation and case
 * stripped out, which is the only way to tell those apart cheaply.
 */
function labelWorthShowing(property: string, label?: string): boolean {
  if (!label) return false;
  const flatten = (text: string) => text.toLowerCase().replace(/[^a-z0-9]/g, "");
  return flatten(label) !== flatten(localName(property));
}

/** Which definition a property's values are checked against. */
function takes(spec: Property): string | null {
  const ref = spec.items?.$ref ?? spec.$ref;
  return ref ? ref.replace(".json", "") : null;
}

/**
 * Ref and Text are written as an `anyOf` rather than a property bag, because
 * each may be written two ways: a reference is a bare URI or a node, and a
 * literal is a plain scalar or a value object. The properties belong to the
 * node branch, so they are found there.
 */
const branches = schema.anyOf ?? [];
const node = branches.find((branch) => branch.type === "object");
const shape = node ?? schema;

const properties = Object.entries(shape.properties ?? {}).filter(
  ([name]) => !KEYWORDS.includes(name),
);

/** How to describe a branch's type in a sentence. */
const named = (type?: string | string[]) =>
  Array.isArray(type) ? type.join(", ") : (type ?? "any");

const term = vocabulary.terms as Record<
  string,
  { label?: string; definition?: string; notes?: string[] } | undefined
>;
const own = term[definition!];
const primer = PRIMER[`${definition}.json`];

const title = schema.title ?? definition!;
const examples = schema.examples ?? [];
const headings = [
  ...(examples.length ? [{ depth: 2, slug: "example", text: "Example" }] : []),
  { depth: 2, slug: "properties", text: "Properties" },
  { depth: 2, slug: "the-schema", text: "The schema" },
];
---

<StarlightPage
  frontmatter={{
    title,
    description: schema.description ?? own?.definition,
    tableOfContents: { minHeadingLevel: 2, maxHeadingLevel: 2 },
  }}
  headings={headings}
>
  {schema.description && <p>{schema.description}</p>}

  {
    branches.length > 0 && (
      <>
        <p>
          A value here may be written two ways, and both conform. A reader has
          to handle either.
        </p>
        <ul>
          {branches.map((branch) => (
            <li>
              <strong>{named(branch.type)}</strong>
              {branch.description && <> &mdash; {branch.description}</>}
            </li>
          ))}
        </ul>
      </>
    )
  }

  {
    own?.definition && (
      <blockquote>
        <p>{own.definition}</p>
        <p>
          <small>
            BIBFRAME's definition of <code>bf:{definition}</code>
            {own.label && own.label !== title && <> , labelled “{own.label}”</>}.
            {primer && (
              <>
                {" "}
                The primer has <a href={primer}>a section on it</a>.
              </>
            )}
          </small>
        </p>
      </blockquote>
    )
  }

  {
    examples.length > 0 && (
      <>
        <h2 id="example">{examples.length > 1 ? "Examples" : "Example"}</h2>
        {examples.map((example) => (
          <Code code={JSON.stringify(example, null, 2)} lang="json" />
        ))}
        <p>
          Trimmed from a real record rather than written for the occasion, and
          checked against this definition by <code>tests/test_examples.py</code>
          . A wrong example is worse than none, because it is the first thing
          anyone copies.
        </p>
      </>
    )
  }

  <h2 id="properties">Properties</h2>

  {
    properties.length === 0 ? (
      <p>
        This definition names no properties of its own. Every property a
        record carries is still required to be an array, whatever it is
        called.
      </p>
    ) : (
      <table>
        <thead>
          <tr>
            <th>Property</th>
            <th>Takes</th>
            <th>What BIBFRAME says it is</th>
          </tr>
        </thead>
        <tbody>
          {properties.map(([name, spec]) => {
            const entry = term[localName(name)];
            const target = takes(spec);
            return (
              <tr>
                <td>
                  <code>{name}</code>
                </td>
                <td>
                  {target ? (
                    <a href={`${import.meta.env.BASE_URL}shape/${target}/`}>
                      {target}
                    </a>
                  ) : (
                    <span>{spec.type ?? "any"}</span>
                  )}
                </td>
                <td>
                  {entry?.definition ? (
                    <>
                      {entry.definition}
                      {labelWorthShowing(name, entry.label) && (
                        <> ({entry.label})</>
                      )}
                    </>
                  ) : foreign(name) ? (
                    <em>
                      defined by <a href={foreign(name)!.href}>
                        {foreign(name)!.name}
                      </a>
                    </em>
                  ) : (
                    <em>not in the vocabulary</em>
                  )}
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    )
  }

  <p>
    Every property here holds an array, and a property this definition does not
    name is still checked: it must be an array too. Naming a property buys a
    check on what its values look like, and nothing else.
  </p>

  <h2 id="the-schema">The schema</h2>

  <p>
    <a href={url(`schema/dialect/${definition}.json`)}>
      <code>{url(`schema/dialect/${definition}.json`)}</code>
    </a>{" "}
    is this definition on its own, and{" "}
    <a href={url("schema/dialect.json")}>
      <code>{url("schema/dialect.json")}</code>
    </a>{" "}
    is the whole shape with every definition inlined. They are checked against
    each other over the conformance corpus, so either is safe to depend on.
  </p>
</StarlightPage>
