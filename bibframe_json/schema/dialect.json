              "type": "array"
            },
            {
              "type": "string"
            }
          ],
          "$comment": "An array when a node has several types, a string when it has one. @type is a keyword, so no @container reaches it."
        },
        "rdfs:label": {
          "items": {
            "$ref": "#/$defs/Text"
          },
          "title": "Rdfs:Label",
          "type": "array"
        },
        "relationship": {
          "items": {
            "$ref": "#/$defs/Ref"
          },
          "title": "Relationship",
          "type": "array"
        },
