    "Text": {
      "$comment": "A literal: a plain scalar, or a value object. The scalar branch exists because Text.accept_a_bare_string is a validator, and model_json_schema() emits no validators.",
      "anyOf": [
        {
          "type": [
            "string",
            "number",
            "boolean"
          ]
        },
        {
          "additionalProperties": true,
          "description": "A literal that still knows its language and datatype.\n\nFlattening a literal to a bare string loses meaning here, not just metadata,\nwhich is why this is a model rather than a `str` field:\n\n- `date` carries three datatypes in real records -- xsd:dateTime, xsd:date\n  and EDTF. EDTF encodes uncertainty (`199X`, `1970?`, intervals), so\n  reading it as an xsd:date is wrong.\n- a language tag is often the only thing telling parallel scripts apart. 101\n  properties hold both a romanised and a vernacular form of one value, and\n  `bluecore_api` currently renders them comma-joined as though they were two\n  different titles.\n\n`__str__` returns the value, so a template writing `{{ title }}` gets the\ntext and needs to know none of this.",
          "properties": {
            "@value": {
              "title": "@Value",
              "type": "string"
            },
            "@language": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "@Language"
            },
            "@type": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "@Type"
            }
          },
          "required": [
            "@value"
          ],
          "title": "Text",
          "type": "object",
          "not": {
            "required": [
              "@type",
              "@language"
            ]
          },
          "$comment": "A value object carries at most one of @type or @language, never both: required by JSON-LD and confirmed in the data -- 703 with a datatype, 68 with a language, none with both. Written here rather than as a model validator: the models parse and this judges, and a validator would not reach model_json_schema() anyway."
        }
      ]
    },
