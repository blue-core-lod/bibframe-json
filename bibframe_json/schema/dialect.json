    "Relation": {
      "additionalProperties": {
        "$comment": "A property with no field in the models is still a property, so it is still an array. Without this the guarantee holds only for the properties that happen to be modelled.",
        "type": "array"
      },
      "description": "How one resource points at another, and what the pointing means.\n\n`relationship` names the kind, and a relation routinely names two at once --\n\"part of\" and \"holding of\" -- which is why it is a list and why LC files the\nrelation under both headings rather than choosing.\n\n`associated_resource` is the other end, and it is a Resource rather than a\nRef because a series relation frequently describes it in place: a bf:Title\nof its own, in two scripts, with no URI anywhere. Typed Resource and not\nWork deliberately -- either end can be any resource type, and a\nself-referential Work would make the generated schema a $ref to itself.",
      "properties": {
        "@id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "@Id"
        },
        "@type": {
