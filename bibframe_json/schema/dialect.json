              "type": "array"
            },
            "source": {
              "items": {
                "$ref": "#/$defs/Ref"
              },
              "title": "Source",
              "type": "array"
            }
          },
          "title": "Ref",
          "type": "object",
          "not": {
            "required": [
              "@id"
            ],
            "properties": {
              "@id": {
                "pattern": "^_:"
              }
            }
          },
          "$comment": "A node, and one that keeps no @id if it is blank -- see forbid_blank_node_id, which every node definition shares."
        }
      ]
