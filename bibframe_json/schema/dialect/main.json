    "required": [
      "@type"
    ],
    "properties": {
      "@type": {
        "anyOf": [
          {
            "type": "array",
            "contains": {
              "const": "Hub"
            }
          },
          {
            "const": "Hub"
          }
        ]
      }
    }
  },
  "then": {
    "$ref": "Hub.json"
  },
  "else": {
    "if": {
      "required": [
        "@type"
      ],
      "properties": {
        "@type": {
          "anyOf": [
            {
              "type": "array",
              "contains": {
                "const": "Instance"
              }
            },
            {
              "const": "Instance"
            }
          ]
        }
      }
    },
    "then": {
      "$ref": "Instance.json"
    },
    "else": {
      "if": {
        "required": [
          "@type"
        ],
        "properties": {
          "@type": {
            "anyOf": [
              {
                "type": "array",
                "contains": {
                  "const": "Item"
                }
              },
              {
                "const": "Item"
              }
            ]
          }
        }
      },
      "then": {
        "$ref": "Item.json"
      },
      "else": {
        "$ref": "Work.json"
      }
    }
  }
}
