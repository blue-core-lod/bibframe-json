---
/**
 * The definitions in the shape, each with what it is and where to read more.
 *
 * Read out of the schema files, so this cannot list something that is not
 * there or miss something that is. `title` and `description` are already
 * written in each one, because they are what a validator surfaces, which
 * makes this table the schemas describing themselves.
 */
import { PRIMER } from "../data/primer";

type Schema = { title?: string; description?: string };

const files = import.meta.glob<Schema>(
  "../../../bibframe_json/schema/dialect/*.json",
  { eager: true, import: "default" },
);

const RESOURCES = ["Work", "Instance", "Hub", "Item"];

const definitions = Object.entries(files)
  .map(([path, schema]) => ({
    name: path.split("/").pop()!.replace(".json", ""),
    schema,
  }))
  .filter(({ name }) => name !== "main")
  .sort((a, b) => {
    const rank = (name: string) =>
      RESOURCES.includes(name) ? RESOURCES.indexOf(name) : RESOURCES.length;
    return rank(a.name) - rank(b.name) || a.name.localeCompare(b.name);
  });
---

<table>
  <thead>
    <tr>
      <th>Definition</th>
      <th>What it is</th>
      <th>In the model</th>
    </tr>
  </thead>
  <tbody>
    {
      definitions.map(({ name, schema }) => (
        <tr>
          <td>
            <a href={`${import.meta.env.BASE_URL}shape/${name}/`}>{name}</a>
          </td>
          <td>{schema.description ?? schema.title ?? ""}</td>
          <td>
            {PRIMER[`${name}.json`] && (
              <a href={PRIMER[`${name}.json`]}>primer</a>
            )}
          </td>
        </tr>
      ))
    }
  </tbody>
</table>
