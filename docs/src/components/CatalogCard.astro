---
/**
 * A catalog card, and the same record as JSON.
 *
 * ISBD has structured bibliographic description with delimiters since 1971:
 * title / responsibility. -- edition. -- place : publisher, date. That is the
 * same idea as this project, so the front page shows both halves. The
 * prescribed punctuation carries the red, quietly and without comment: a
 * cataloger reads it without being told, and nobody else needs to.
 *
 * Generated from example/linked.json, which validates, rather than typed
 * out. The Instance and not a BOUNDED: ISBD's nine areas are all description,
 * and description is Instance-level. A bounded description would put an embedded Work on the
 * page with nothing on the card answering to it -- the heading, the tracings
 * and the call number a real card shows are the cataloging code's business,
 * not ISBD's. A card with a hand-written title would look identical and mean
 * nothing. Every field below is indexed directly, so a record missing one
 * fails the build instead of quietly rendering a gap.
 *
 * The prose between the two halves is a slot, so it lives in index.mdx where
 * it can be edited without touching this file. Everything here is either
 * generated from the record or structure.
 *
 * Ported from generate/site.py. The Python version had a test asserting every
 * fragment here is a real string in the record; pytest cannot reach an Astro
 * component, so that guarantee is weaker now -- direct indexing catches a
 * missing field but not an invented one.
 */
import record from "../../../example/linked.json";
import { url } from "../data/published";

const CARD_MONO = "0.8rem";


type Area = { key: string; delimiter: string; breaks: number; value: string };

const place = record.provisionActivity[0]["bflc:simplePlace"][0];
const publisher = record.provisionActivity[0]["bflc:simpleAgent"][0];
const date = record.provisionActivity[0]["bflc:simpleDate"][0];
const isbn = record.identifiedBy.find((id) => id["@type"].includes("Isbn"))!;

// The areas a card shows, in the order it shows them. Areas 1 to 4 run on as
// one paragraph; the physical description, the note and the ISBN each start a
// line. \0 marks a delimiter falling inside an area rather than between two,
// so area 4's " : " and ", " are marked like the rest.
const AREAS: Area[] = [
  { key: "title", delimiter: "", breaks: 0, value: record.title[0].mainTitle[0] },
  {
    key: "responsibilityStatement",
    delimiter: " / ",
    breaks: 0,
    value: record.responsibilityStatement[0],
  },
  {
    key: "editionStatement",
    delimiter: ". — ",
    breaks: 0,
    value: record.editionStatement[0],
  },
  {
    key: "provisionActivity",
    delimiter: ". — ",
    breaks: 0,
    value: `${place}\0 : \0${publisher}\0, \0${date}.`,
  },
  {
    key: "extent",
    delimiter: "",
    breaks: 1,
    value: record.extent[0]["rdfs:label"][0],
  },
  { key: "dimensions", delimiter: " ; ", breaks: 0, value: `${record.dimensions[0]}.` },
  { key: "note", delimiter: "", breaks: 2, value: record.note[0]["rdfs:label"][0] },
  {
    key: "identifiedBy",
    delimiter: "",
    breaks: 2,
    value: `ISBN ${isbn["rdf:value"][0]} (${isbn.qualifier[0]})`,
  },
];

const escape = (text: string) =>
  text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");

const mark = (text: string) => `<span class="d">${escape(text)}</span>`;

/**
 * An area delimiter, marked up so it can be colored.
 *
 * No arithmetic. ISBD A.3.2.7 is explicit that when an element ends with a
 * point and the next area's prescribed punctuation begins with one, both
 * points are given, so that an abbreviation's point and the prescribed point
 * are each accounted for:
 *
 *     . -- 3rd ed.. --      not  . -- 3rd ed. --
 *     by J. Smith, Esq.. -- not  by J. Smith, Esq. --
 *
 * So "Madhusudan.. -- 2nd revised edition" is correct and the single point
 * this used to emit was not. It looks wrong to a modern eye, which is
 * presumably why I talked myself into the other rule.
 */
function delimiter(prescribed: string): string {
  return prescribed ? mark(prescribed) : "";
}

let description = "";
for (const area of AREAS) {
  if (area.breaks) {
    description += "<br>".repeat(area.breaks);
  } else {
    description += delimiter(area.delimiter);
  }
  description += area.value
    .split("\0")
    .map((part, i) => (i % 2 === 0 ? escape(part) : mark(part)))
    .join("");
}

/** JSON with any array of scalars kept on one line.
 *
 * json.dumps-style indentation gives every value in this shape three lines,
 * because every value is an array: the record runs to eighty lines of which
 * most are a bracket. Beside a five-line card that loses the comparison the
 * card is here to make.
 */
function compact(node: unknown, level = 0): string {
  const pad = "  ".repeat(level);
  const inner = "  ".repeat(level + 1);
  if (Array.isArray(node)) {
    if (node.every((item) => typeof item !== "object" || item === null)) {
      return `[${node.map((item) => JSON.stringify(item)).join(", ")}]`;
    }
    const items = node.map((item) => `${inner}${compact(item, level + 1)}`);
    return `[\n${items.join(",\n")}\n${pad}]`;
  }
  if (node && typeof node === "object") {
    const pairs = Object.entries(node).map(
      ([key, value]) => `${inner}${JSON.stringify(key)}: ${compact(value, level + 1)}`,
    );
    return `{\n${pairs.join(",\n")}\n${pad}}`;
  }
  return JSON.stringify(node);
}

/**
 * Tokenise the JSON so it can be highlighted, and only where highlighting
 * says something true.
 *
 * Three distinctions, two of them free. Structural punctuation takes the
 * stamp red, because that is the claim this page makes. A property name is
 * set in weight rather than in another color, because it is a name and not
 * a different kind of thing. A string value takes the one other hue already
 * in the palette. Anything else -- a number, a boolean, null -- stays in the
 * ink color.
 *
 * Walked rather than matched with a pattern, so punctuation inside a string
 * is left alone. That is not a detail: the ";" in "Chakravorti ; foreward by
 * Prof. Penna Madhusudan" is a real ISBD delimiter sitting inside a
 * transcribed literal, where no parser can reach it. It stays in the ink
 * color in both halves, and that is the argument for putting the structure
 * in the JSON instead.
 *
 * A string is a property name when the next thing that is not whitespace is a
 * colon, which is the whole of JSON's grammar on the point.
 */
type Token = { text: string; kind: "punct" | "string" | "plain" };

function tokenise(json: string): Token[] {
  const tokens: Token[] = [];
  let index = 0;
  while (index < json.length) {
    const character = json[index];
    if (character === '"') {
      let end = index + 1;
      while (end < json.length) {
        if (json[end] === "\\") {
          end += 2;
          continue;
        }
        if (json[end] === '"') break;
        end += 1;
      }
      tokens.push({ text: json.slice(index, end + 1), kind: "string" });
      index = end + 1;
    } else if ("{}[]:,".includes(character)) {
      tokens.push({ text: character, kind: "punct" });
      index += 1;
    } else {
      let end = index;
      while (end < json.length && !'"{}[]:,'.includes(json[end])) end += 1;
      tokens.push({ text: json.slice(index, end), kind: "plain" });
      index = end;
    }
  }
  return tokens;
}

function highlight(json: string): string {
  const tokens = tokenise(json);
  return tokens
    .map((token, i) => {
      if (token.kind === "punct") return mark(token.text);
      if (token.kind === "string") {
        const next = tokens.slice(i + 1).find((t) => t.text.trim() !== "");
        const isName = next?.kind === "punct" && next.text === ":";
        return `<span class="${isName ? "k" : "s"}">${escape(token.text)}</span>`;
      }
      return escape(token.text);
    })
    .join("");
}

// Cut to what the card above draws on, so the two halves say the same thing
// and a reader can find any line of one in the other. The record carries
// adminMetadata, carrier, media and issuance too, and none of them has an
// ISBD counterpart -- on the page they read as noise the card is ignoring.
//
// @context, @id and @type come along regardless. They are not ISBD, but a
// document without them is not this shape either, and @context is the one
// thing the schema requires.
const KEYWORDS = ["@context", "@id", "@type"] as const;
// instanceOf is not an ISBD area and is here anyway: it is the one place the
// page can show a reference rather than an embedding, which is the whole
// difference between this record and a bounded description of it.
const shown = Object.fromEntries([
  ...KEYWORDS.map((key) => [key, record[key]]),
  ["instanceOf", record.instanceOf],
  ...AREAS.map(({ key }) => [
    key,
    // one publication statement, because ISBD transcribes one
    key === "provisionActivity"
      ? record.provisionActivity.slice(0, 1)
      : record[key as keyof typeof record],
  ]),
]);
/**
 * One @type per node, for this page only.
 *
 * Two nodes in the record carry several, and the schema wants them all: @type
 * is a list of classes and a reader must not assume one. Trimming here is the
 * front page keeping an example legible, not a claim about the shape, which is
 * why the whole record is linked beside it.
 *
 * Which one to keep is a judgment, so it is written down rather than derived
 * from the ontology. A node whose types are not listed throws, because a
 * silent guess is how the page would come to disagree with the record.
 */
const ONE_TYPE: Record<string, string> = {
  // Publication is a subclass of ProvisionActivity, so it says more.
  "ProvisionActivity|Publication": "Publication",
  // The other one is an mnotetype vocabulary term rather than an ontology
  // class, so the class is the readable half.
  "Note|http://id.loc.gov/vocabulary/mnotetype/biblio": "Note",
};

function oneType(node: unknown): unknown {
  if (Array.isArray(node)) return node.map(oneType);
  if (node === null || typeof node !== "object") return node;
  const out: Record<string, unknown> = {};
  for (const [key, value] of Object.entries(node)) {
    if (key === "@type" && Array.isArray(value) && value.length > 1) {
      const chosen = ONE_TYPE[value.join("|")];
      if (!chosen) {
        throw new Error(
          `CatalogCard: no choice recorded for @type ${JSON.stringify(value)}. ` +
            `Add it to ONE_TYPE rather than letting the page guess.`,
        );
      }
      out[key] = [chosen];
    } else {
      out[key] = oneType(value);
    }
  }
  return out;
}
---

<figure class="plate" style={`--card-mono: ${CARD_MONO}`}>
  <div class="card" role="img" aria-label="A catalog card for the record below">
    <p class="description" set:html={description} />
  </div>

  <div class="between"><slot /></div>

  <pre class="record"><code set:html={highlight(compact(oneType(shown)))} /></pre>

</figure>
